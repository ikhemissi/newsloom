{
  "subscription_id": "${AZURE_SUBSCRIPTION_ID}",
  "environment_name": "${AZURE_ENV_NAME}",
  "location": "${AZURE_LOCATION}",
  "resource_group_name": "${APPLICATION_RESOURCE_GROUP}",
  "postgres_sku": "${POSTGRES_SKU}",
  "postgres_storage_mb": "${POSTGRES_STORAGE_MB}",
  "postgres_backup_days": "${POSTGRES_BACKUP_DAYS}",
  "log_retention_days": "${LOG_RETENTION_DAYS}",
  "log_daily_cap_gb": "${LOG_DAILY_CAP_GB}",
  "models": {
    "enrichment": {
      "deployment_name": "${ENRICHMENT_DEPLOYMENT}",
      "name": "${ENRICHMENT_MODEL}",
      "version": "${ENRICHMENT_VERSION}",
      "format": "${ENRICHMENT_FORMAT}",
      "sku": "${ENRICHMENT_SKU}",
      "capacity": "${ENRICHMENT_CAPACITY}"
    },
    "embeddings": {
      "deployment_name": "${EMBEDDINGS_DEPLOYMENT}",
      "name": "${EMBEDDINGS_MODEL}",
      "version": "${EMBEDDINGS_VERSION}",
      "format": "${EMBEDDINGS_FORMAT}",
      "sku": "${EMBEDDINGS_SKU}",
      "capacity": "${EMBEDDINGS_CAPACITY}"
    },
    "screening": {
      "deployment_name": "${SCREENING_DEPLOYMENT}",
      "name": "${SCREENING_MODEL}",
      "version": "${SCREENING_VERSION}",
      "format": "${SCREENING_FORMAT}",
      "sku": "${SCREENING_SKU}",
      "capacity": "${SCREENING_CAPACITY}"
    }
  },
  "tags": {
    "project": "newsloom",
    "SecurityControl": "${SECURITY_CONTROL_TAG}",
    "CostControl": "${COST_CONTROL_TAG}"
  }
}
